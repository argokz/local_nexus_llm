# GTX 1660 Ti 6GB + 32GB RAM — Docker GPU overlay.
# Usage:  docker compose --env-file env/gpu-1660ti.env -f docker-compose.yml -f docker-compose.gpu.yml --profile stt up --build -d
# Or:     .\scripts\start-docker.ps1

HOST_PROFILE=gpu-1660ti-32g
# Turing sm_75. Change only if you rebuild for a different NVIDIA GPU.
CUDA_ARCHITECTURES=75

# 35B-A3B MoE (3B active): ~16.4 GB weights in RAM, GPU holds as many tensors as 6 GB allows.
# Stronger quant if you close other apps: Qwen3.5-35B-A3B-Q4_K_S.gguf (~20.7 GB) — tight with Docker.
CHAT_HF_REPO=unsloth/Qwen3.5-35B-A3B-GGUF
CHAT_HF_FILE=Qwen3.5-35B-A3B-Q3_K_M.gguf
CHAT_GGUF=qwen-chat.gguf

EMBED_HF_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBED_HF_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_GGUF=qwen-embed.gguf

LLAMA_NGL=99
LLAMA_CTX=8192
LLAMA_THREADS=8
LLAMA_PARALLEL=1
LLM_MEM_LIMIT=20g
LLAMA_CPU_VARIANT=cuda

CHAT_API_BASE=http://llm:8001/v1
EMBED_API_BASE=http://embed:8003/v1
WHISPER_API_BASE=http://whisper:8000/v1

# Medium on CPU: 6 GB VRAM is given to llama.cpp. Set cuda + latest-cuda image only if you drop NGL.
WHISPER_MODEL=Systran/faster-whisper-medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
