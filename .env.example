# Copy to .env and edit. Master key MUST start with sk-
LITELLM_MASTER_KEY=sk-localnexus-admin
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# Bound on the host for LAN clients. 0.0.0.0 = all interfaces.
LITELLM_PORT=4000

# Chat / embedding / whisper upstream LiteLLM talks to.
# Docker sandbox: http://llm:8001/v1 and http://embed:8003/v1
# Linux host llama-server: http://127.0.0.1:8001/v1 and http://127.0.0.1:8003/v1
# (from a container use host.docker.internal instead of 127.0.0.1)
CHAT_API_BASE=http://llm:8001/v1
EMBED_API_BASE=http://embed:8003/v1
# Docker: http://whisper:8000/v1
# Linux host (scripts/start-whisper.sh): http://127.0.0.1:8000/v1
WHISPER_API_BASE=http://whisper:8000/v1
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus
# Host STT without Docker. medium on CPU if RAM allows; start-whisper.sh may fall back to small.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Set to 99 when a CUDA GPU appears. Keep 0 on this machine.
LLAMA_NGL=0
LLAMA_THREADS=4
LLAMA_CTX=4096
# Native host: 1 slot saves KV RAM. Docker sandbox can stay at default/auto.
LLAMA_PARALLEL=1

# llama.cpp CPU ISA. Windows i7-2600 sandbox: avx. Linux AVX2+ host: native.
# scripts/detect-hw.sh writes the rest into host.auto.env (not committed).
LLAMA_CPU_VARIANT=avx
LLM_MEM_LIMIT=8g

# Chat GGUF (downloaded as models/qwen-chat.gguf). Override after detect-hw.sh.
# sandbox: unsloth/Qwen3-4B-GGUF  Qwen3-4B-Q4_K_M.gguf
# this 16GB Linux box: unsloth/Qwen3.5-9B-GGUF  Qwen3.5-9B-Q5_K_M.gguf
CHAT_HF_REPO=unsloth/Qwen3-4B-GGUF
CHAT_HF_FILE=Qwen3-4B-Q4_K_M.gguf
